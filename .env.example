# URL real del sitio; necesaria para canonical, sitemap y metadatos absolutos.
PUBLIC_SITE_URL=
# Producción: owner/repository. Vacío = editor local únicamente en desarrollo.
PUBLIC_KEYSTATIC_REPO=
# Keystatic genera estas variables durante la conexión de la GitHub App.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Opcional fuera de Vercel: node (por defecto) o vercel.
DEPLOY_TARGET=node